{
  "name": "undercurrent",
  "version": "0.1.3",
  "private": true,
  "description": "Undercurrent: an unofficial, best-effort TypeScript port of Headlong (laude-institute/headlong). Dispatcher + two-thinker (monolith + responder) topology over one stream. Not affiliated with the Headlong authors.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wolfyy970/undercurrent.git"
  },
  "homepage": "https://github.com/wolfyy970/undercurrent#readme",
  "bugs": {
    "url": "https://github.com/wolfyy970/undercurrent/issues"
  },
  "type": "module",
  "exports": {
    ".": "./src/api.ts",
    "./package.json": "./package.json"
  },
  "bin": {
    "chat": "bin/chat",
    "context": "bin/context",
    "identity": "bin/identity",
    "llm": "bin/llm",
    "mem": "bin/mem",
    "recap": "bin/recap",
    "skills": "bin/skills",
    "thinkers": "bin/thinkers",
    "traj": "bin/traj",
    "shellm": "bin/shellm",
    "headlong-killall": "bin/headlong-killall",
    "headlong-slack-bridge": "bin/headlong-slack-bridge",
    "headlong-telegram-bridge": "bin/headlong-telegram-bridge",
    "headlong-init": "bin/headlong-init"
  },
  "files": [
    "bin/",
    "src/",
    "web/",
    "tui/",
    "docs/",
    "install.mjs",
    "status.mjs",
    "uninstall.mjs",
    "LICENSE",
    "NOTICE",
    "README.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md"
  ],
  "engines": {
    "bun": ">=1.4.4",
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node -e \"require('fs').cpSync('src/assets','dist/src/assets',{recursive:true})\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "real-wake": "pnpm build && bun dist/scripts/real-wake.js",
    "real-reactive": "pnpm build && bun dist/scripts/real-reactive.js",
    "upstream-tests": "bun parity/upstream-tests/run.mjs",
    "live-proof": "bun scripts/live-proof.ts"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.7.0",
    "vitest": "^5.1.0"
  }
}
